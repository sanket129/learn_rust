# Copy to .env and fill in real values. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   echo "JWT_SECRET=$(openssl rand -hex 32)" >> .env
#
# Generate a different secret per environment. Rotating JWT_SECRET invalidates
# every token already issued.

# Signing key for HS256 JWTs (32 random bytes, hex).
# Generate: openssl rand -hex 32
JWT_SECRET=

# Personal NVIDIA API key (not used by the Rust app yet).
NVIDIA=
